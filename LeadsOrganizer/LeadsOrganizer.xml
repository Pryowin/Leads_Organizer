<GuiXml>
    <Controls>
        <!-- One row in the results scroll list -->
        <Control name="LeadsOrganizerLeadRow" virtual="true">
            <Dimensions y="44" />
            <Controls>
                <Label name="$(parent)Text" font="ZoFontGameSmall" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_DEFAULT" wrapMode="WRAP" maxLineCount="2" verticalAlignment="CENTER">
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" offsetX="6" offsetY="0" />
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" offsetX="-8" offsetY="0" />
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="LeadsOrganizerWindowTopLevel" movable="true" clampedToScreen="true" mouseEnabled="true" hidden="true">
            <Dimensions x="540" y="640" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)Backdrop" inherits="ZO_DefaultBackdrop">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Backdrop>

                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop" relativePoint="TOPRIGHT" offsetX="-8" offsetY="8" />
                </Button>

                <Label name="$(parent)Title" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Leads Organizer">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop" relativePoint="TOPLEFT" offsetX="16" offsetY="14" />
                </Label>

                <Label name="$(parent)SortLabel" font="ZoFontGame" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Sort active leads (journal):">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="14" />
                </Label>
                <Control name="$(parent)SortDropdown" inherits="ZO_ComboBox">
                    <Dimensions x="500" y="30" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SortLabel" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="6" />
                </Control>

                <Button name="$(parent)HideScryingToggle" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SortDropdown" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="14" />
                </Button>
                <Label name="$(parent)HideScryingLabel" font="ZoFontGame" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Hide if Scrying skill is too low for this lead" wrapMode="WRAP">
                    <Dimensions x="500" y="0" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)HideScryingToggle" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="6" />
                </Label>

                <Button name="$(parent)ShowGreenToggle" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)HideScryingLabel" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="10" />
                </Button>
                <Label name="$(parent)ShowGreenLabel" font="ZoFontGame" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Show green always-available zone leads" wrapMode="WRAP">
                    <Dimensions x="500" y="0" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ShowGreenToggle" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="6" />
                </Label>

                <Button name="$(parent)ShowDoneToggle" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ShowGreenLabel" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="10" />
                </Button>
                <Label name="$(parent)ShowDoneLabel" font="ZoFontGame" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Show leads completed before on this character" wrapMode="WRAP">
                    <Dimensions x="500" y="0" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ShowDoneToggle" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="6" />
                </Label>

                <Label name="$(parent)ResultsHeader" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="Active leads (matches journal filters):">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ShowDoneLabel" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="16" />
                </Label>

                <Backdrop name="$(parent)ResultsBackdrop" inherits="ZO_DefaultBackdrop">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ResultsHeader" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="6" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Backdrop" relativePoint="BOTTOMRIGHT" offsetX="-12" offsetY="-12" />
                    <Controls>
                        <Control name="$(parent)ScrollList" inherits="ZO_ScrollList">
                            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" offsetX="4" offsetY="4" />
                            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" offsetX="-4" offsetY="-4" />
                        </Control>
                    </Controls>
                </Backdrop>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
